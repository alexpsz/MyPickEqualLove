{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mypick.kozueginko.com/schemas/archetype-source-map-v1.json",
  "title": "MyPick =LOVE archetype source map",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "projectId", "experienceId", "songs"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "projectId": { "const": "equal-love" },
    "experienceId": { "const": "standard-top10" },
    "songs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "songId",
          "title",
          "sourceMode",
          "sourceUrl",
          "videoId",
          "videoTitle",
          "channelId",
          "channelTitle",
          "durationSeconds",
          "clipScope",
          "sourceAuthority",
          "sourceNotes",
          "qaFlags"
        ],
        "properties": {
          "songId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "title": { "type": "string", "minLength": 1 },
          "sourceMode": {
            "enum": [
              "official-mv",
              "official-art-track",
              "official-dance",
              "official-live",
              "text-only"
            ]
          },
          "sourceUrl": { "type": "string", "format": "uri" },
          "videoId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{6,}$"
          },
          "videoTitle": { "type": "string", "minLength": 1 },
          "channelId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{6,}$"
          },
          "channelTitle": { "type": "string", "minLength": 1 },
          "durationSeconds": { "type": "integer", "minimum": 1 },
          "clipScope": { "enum": ["single-song", "long-form"] },
          "sourceAuthority": { "const": "official" },
          "sourceNotes": { "type": "string" },
          "qaFlags": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
