{
  "name": "mypickequallove",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "prepare": "node scripts/install-git-hooks.mjs",
    "dev": "next dev --webpack",
    "dev:equal-love": "node scripts/run-project-command.mjs equal-love dev",
    "dev:nearly-equal-joy": "node scripts/run-project-command.mjs nearly-equal-joy dev",
    "dev:not-equal-me": "node scripts/run-project-command.mjs not-equal-me dev",
    "build": "node scripts/clean-static-export.mjs && next build && node scripts/copy-public-assets.mjs",
    "build:equal-love": "node scripts/run-project-command.mjs equal-love build",
    "build:nearly-equal-joy": "node scripts/run-project-command.mjs nearly-equal-joy build",
    "build:not-equal-me": "node scripts/run-project-command.mjs not-equal-me build",
    "start": "node scripts/run-project-command.mjs serve",
    "lint": "eslint src scripts next.config.ts eslint.config.mjs postcss.config.mjs",
    "typecheck": "tsc --noEmit --incremental false",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sync:data": "python scripts/sync-project-discography.py --project equal-love",
    "sync:data:equal-love": "python scripts/sync-project-discography.py --project equal-love",
    "sync:data:nearly-equal-joy": "python scripts/sync-project-discography.py --project nearly-equal-joy",
    "sync:data:not-equal-me": "python scripts/sync-project-discography.py --project not-equal-me",
    "sync:data:all": "npm run sync:data:equal-love && npm run sync:data:nearly-equal-joy && npm run sync:data:not-equal-me",
    "sync:songs:equal-love": "python scripts/sync-project-discography.py --project equal-love --songs-only",
    "sync:songs:nearly-equal-joy": "python scripts/sync-project-discography.py --project nearly-equal-joy --songs-only",
    "sync:songs:not-equal-me": "python scripts/sync-project-discography.py --project not-equal-me --songs-only",
    "sync:songs:all": "npm run sync:songs:equal-love && npm run sync:songs:nearly-equal-joy && npm run sync:songs:not-equal-me && npm run format:data:songs",
    "format:data:songs": "prettier --write \"src/projects/*/songs.json\"",
    "check:data:sync": "node scripts/check-discography-update.mjs",
    "check:data:sync:strict": "node scripts/check-discography-update.mjs --enforce-allowlist",
    "test:discography": "python scripts/test_sync_project_discography.py && node scripts/check-discography-update.mjs --self-test",
    "test:board-state": "node scripts/run-board-tests.mjs",
    "test:song-search": "node --test scripts/test-song-search.mjs",
    "test:pick-reordering": "node scripts/test-pick-reordering.mjs",
    "test:share-links": "node scripts/test-board-share-protocol.mjs",
    "test:export-presets": "node scripts/run-export-preset-tests.mjs",
    "test:export-board": "node scripts/run-export-board-tests.mjs",
    "test:pick-assistant": "node scripts/run-pick-assistant-tests.mjs",
    "test:image-actions": "node scripts/run-image-action-tests.mjs",
    "test:compiled-runner": "node --test scripts/tests/compiled-test-runner.test.mjs",
    "test:controls-layout": "node scripts/test-controls-layout.mjs",
    "test:colors": "node scripts/run-color-tests.mjs",
    "test:project-identity": "node scripts/test-project-identity.mjs",
    "test:archetype-labeler": "node scripts/archetype/test-archetype-labeler.mjs",
    "test:archetype-affinity": "node scripts/run-archetype-affinity-tests.mjs",
    "test:archetype-ui": "node scripts/test-archetype-ui.mjs",
    "test:live-experiences": "node scripts/validate-project-data.mjs --self-test-live-experiences",
    "test:static-export": "node scripts/test-static-export-contract.mjs",
    "test": "npm run test:discography && npm run test:board-state && npm run test:song-search && npm run test:pick-reordering && npm run test:share-links && npm run test:export-presets && npm run test:export-board && npm run test:pick-assistant && npm run test:image-actions && npm run test:controls-layout && npm run test:colors && npm run test:project-identity && npm run test:archetype-labeler && npm run test:archetype-affinity && npm run test:archetype-ui && npm run test:live-experiences && npm run test:static-export",
    "verify:static-export": "node scripts/run-project-command.mjs equal-love build-and-verify && node scripts/run-project-command.mjs nearly-equal-joy build-and-verify && node scripts/run-project-command.mjs not-equal-me build-and-verify",
    "verify": "npm run check:repo-boundary && npm run lint && npm run typecheck && npm run validate:data && npm test && npm run verify:static-export",
    "check:repo-boundary": "node scripts/check-repository-boundary.mjs",
    "hooks:install": "node scripts/install-git-hooks.mjs",
    "validate:data": "node scripts/validate-project-data.mjs",
    "validate:data:project": "node scripts/validate-project-data.mjs --project"
  },
  "dependencies": {
    "html2canvas": "^1.4.1",
    "motion": "^13.0.0",
    "next": "^16.2.7",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.7",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1"
  },
  "optionalDependencies": {
    "@tailwindcss/oxide-darwin-arm64": "^4.3.1"
  }
}
