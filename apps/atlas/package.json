{
  "name": "@mypick/atlas",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "lint": "eslint src next.config.ts eslint.config.mjs",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "node --test scripts/foundation.test.mjs scripts/contracts.test.mjs",
    "build": "next build",
    "verify:static-export": "node scripts/verify-static-export.mjs",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build && npm run verify:static-export"
  },
  "dependencies": {
    "next": "^16.2.7",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.7",
    "typescript": "^6.0.3"
  }
}
